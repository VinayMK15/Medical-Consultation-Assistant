# ──────────────────────────────────────────────────────────────────────────────
# MedAssist Backend — .env.example
# Copy this file to .env and fill in real values.
# ──────────────────────────────────────────────────────────────────────────────

# REQUIRED. The backend refuses to start without it.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# Must be at least 32 characters and not the placeholder below. Changing it
# invalidates every issued token.
SECRET_KEY=your-secret-key-here

ALGORITHM=HS256

# Access token lifetime in minutes. 1440 = 24 hours.
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# bcrypt work factor. 12 is the minimum worth using; raising it is safe and
# only slows login, since existing hashes keep verifying at their own cost.
BCRYPT_ROUNDS=12

# Comma-separated list of allowed frontend origins for CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

DATABASE_URL=sqlite:///./medical_app.db

# ──────────────────────────────────────────────────────────────────────────────
# NLP / LLM Configuration
# ──────────────────────────────────────────────────────────────────────────────
# Tier 1: Local Ollama model. qwen2.5:1.5b is recommended — it handles Indic
# scripts (Hindi/Tamil/Telugu/Kannada) far better than llama3, which
# transliterates them and returns garbage.
OLLAMA_MODEL=qwen2.5:1.5b
# Comma-separated backups tried in order if the primary model is slow,
# unloaded or unavailable. Set this way so one model being slow or
# unavailable does not take the whole extraction tier down.
OLLAMA_FALLBACK_MODELS=llama3:latest
OLLAMA_ENABLED=true

# Tier 2 is a deterministic regex matcher (no API key, no network).
# Translation uses Google's client=gtx JSON endpoint with a MyMemory
# fallback — see services/translator_logic.py.

